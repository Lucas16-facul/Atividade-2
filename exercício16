matriz = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]

soma_total = 0

for linha in matriz:
    soma_linha = 0

    for valor in linha:
        print(valor, end=" ")
        soma_total = soma_total + valor
        soma_linha = soma_linha + valor

    print()
    print("Soma da linha:", soma_linha)

print("Soma de todos os valores:", soma_total)
