produtos = ["Teclado", "Mouse", "Monitor", "Notebook", "Headset"]
quantidades = [12, 25, 4, 3, 8]

produto = input("Digite o produto que deseja consultar: ")

encontrado = False

for i in range(len(produtos)):
    if produtos[i].lower() == produto.lower():
        print("Produto:", produtos[i])
        print("Quantidade:", quantidades[i])

        nova_quantidade = int(input("Digite a nova quantidade: "))
        quantidades[i] = nova_quantidade

        encontrado = True

if not encontrado:
    print("Produto não encontrado.")

print("\nProdutos com estoque inferior a 5:")

for i in range(len(produtos)):
    if quantidades[i] < 5:
        print(produtos[i], "-", quantidades[i], "unidades")

maior = quantidades[0]
produto_maior = produtos[0]

for i in range(1, len(quantidades)):
    if quantidades[i] > maior:
        maior = quantidades[i]
        produto_maior = produtos[i]

print("\nProduto com maior quantidade em estoque:")
print(produto_maior, "-", maior, "unidades")
